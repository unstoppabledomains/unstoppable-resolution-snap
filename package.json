{
  "name": "@unstoppabledomains/unstoppable-resolution-snap",
  "version": "1.2.0",
  "description": "Resolve Unstoppable Domains in Metamask",
  "repository": {
    "type": "git",
    "url": "https://github.com/unstoppabledomains/unstoppable-resolution-snap"
  },
  "license": "ISC",
  "exports": {
    "./package.json": "./package.json",
    "./snap.manifest.json": "./snap.manifest.json",
    "./images/icon.svg": "./images/icon.svg",
    "./dist/bundle.js": "./dist/bundle.js",
    "./dist/preinstalled-snap.json": "./dist/preinstalled-snap.json"
  },
  "main": "./dist/bundle.js",
  "files": [
    "dist/",
    "images/icon.svg",
    "snap.manifest.json"
  ],
  "scripts": {
    "build": "yarn build:snap && yarn build:types && yarn build-preinstalled-snap",
    "build-preinstalled-snap": "node scripts/build-preinstalled-snap.js",
    "build:clean": "yarn clean && yarn build",
    "build:snap": "mm-snap build",
    "build:types": "tsc",
    "clean": "rimraf dist",
    "prepublishOnly": "mm-snap manifest",
    "serve": "mm-snap serve",
    "start": "mm-snap watch",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "devDependencies": {
    "@metamask/auto-changelog": "^5.0.2",
    "@metamask/snaps-cli": "^8.1.1",
    "@metamask/snaps-controllers": "^14.2.0",
    "@metamask/snaps-jest": "^9.1.0",
    "@metamask/snaps-sdk": "^9.1.0",
    "@types/jest": "^30.0.0",
    "jest": "^30.0.5",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.4.0",
    "typescript": "^5.8.3"
  },
  "packageManager": "yarn@3.2.1",
  "engines": {
    "node": "^20 || >=22"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "resolutions": {
    "@metamask/snaps-sdk": "9.1.0"
  }
}
